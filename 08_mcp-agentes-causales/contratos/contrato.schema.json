{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contrato Causal",
  "type": "object",
  "required": ["id", "titulo", "operaciones", "entrada", "salida", "invariantes", "fallos", "aceptacion", "criterios_calidad"],
  "properties": {
    "id": { "type": "string", "pattern": "^C-[0-9]{2}$" },
    "titulo": { "type": "string" },
    "capitulo": { "type": "integer", "minimum": 1, "maximum": 15 },
    "operaciones": { "type": "array", "items": { "type": "string" } },
    "entrada": { "type": "object" },
    "salida": { "type": "object" },
    "invariantes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "fallos": { "type": "array", "items": { "type": "string" } },
    "aceptacion": {
      "type": "object",
      "required": ["procedimiento", "semilla", "script"],
      "properties": {
        "procedimiento": { "type": "string" },
        "semilla": { "type": "integer" },
        "script": { "type": "string" }
      }
    },
    "criterios_calidad": { "type": "array", "items": { "type": "string", "pattern": "^Q-[0-9]{2}$" } }
  }
}
